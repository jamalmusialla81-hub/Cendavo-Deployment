+  let error = null;
+  try { vm.runInNewContext(source, sandbox); } catch (e) { error = String(e); }
+  const fire = (type, el) => (form.listeners[type] || []).map(fn => fn({ type, target: el, preventDefault() {} }));
+  const submit = () => Promise.all(fire('submit', form));
