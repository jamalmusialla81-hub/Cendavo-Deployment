+    renderer.setSize(w, h, false);
+    camera.aspect = w / h; camera.updateProjectionMatrix();
+    const narrow = camera.aspect < 0.85;
+    const visH = 2 * Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)) * (camera.position.z + 12);
+    field.scale.set(visH * camera.aspect * 1.5, visH * 1.5, 1);
+    L = !narrow
+      ? { logo: { x: 2.85, y: 0.35, s: 0.92 * Math.min(1, camera.aspect / 1.45) }, gl: [2.6, 1.2, -7.5, -0.24, 0.03], hb: [7.4, -2.4, -9.5, -0.42, 0.05] }
+      : { logo: { x: 0, y: 1.3, s: clamp(camera.aspect * 1.2, 0.45, 0.62) }, gl: [0.9, 3.9, -9, -0.15, 0.04], hb: [-3.2, 6.2, -13, 0.3, 0.05] };
+    markPivot.position.y = 0.85; wordPivot.position.y = -1.75;
+  }
+  layout();
+  window.addEventListener('resize', () => { layout(); if (!running) frame(0); });
+
+  /* motion: frame-rate independent (damped toward the pointer and the hero's scroll progress) */
+  const clock = new THREE.Clock();
+  let elapsed = 0, introT = 0, running = false, inView = true;
+  const sm = { px: 0, py: 0, p: 0 };
+  function placeScreen(name, p, t, i) {
+    const s = screens[name], c = L[name];
+    const k = easeOut(clamp((introT - 0.25 - i * 0.15) / 1.8, 0, 1));
+    const e = smooth(p), side = i ? 1 : -1;
+    /* on exit the screens drift forward and apart, past the glass */
+    s.position.set(c[0] + side * e * 1.6, c[1] + Math.sin(t * 0.35 + i * 1.7) * 0.06 + e * (i ? -0.6 : 0.9), c[2] - (1 - k) * 12 + e * (4.5 + i));
+    s.rotation.set(c[4] + (1 - k) * 0.2 + e * 0.18, c[3] - (1 - k) * 0.4 + side * e * 0.3, 0);
+  }
+  function frame(dt) {
+    elapsed += dt; introT += dt;
+    const t = elapsed;
+    sm.px = damp(sm.px, G.pointer.x || 0, 2.5, dt);
+    sm.py = damp(sm.py, G.pointer.y || 0, 2.5, dt);
+    sm.p = damp(sm.p, G.heroP || 0, 6, dt);
+    const e = smooth(sm.p);
+    fieldMat.uniforms.uTime.value = t;
+    const k = easeOut(clamp(introT / 2.6, 0, 1));
+    logo.scale.setScalar(L.logo.s * (0.84 + 0.16 * k));
+    /* exit: the lockup tilts back and pulls away; yaw stays within YAW so the name never reads backwards */
+    logo.position.set(L.logo.x * (1 - e * 0.35), L.logo.y - (1 - k) * 1.3 + Math.sin(t * 0.6) * 0.05 + e * 0.3, -e * 4.2);
+    logo.rotation.y = clamp(-0.5 * (1 - k) + Math.sin(t * 0.28) * 0.1 + sm.px * 0.2 + e * 0.24, -YAW, YAW);
+    logo.rotation.x = Math.sin(t * 0.21) * 0.04 + sm.py * 0.12 + e * 0.5;
+    logo.rotation.z = -e * 0.05;
+    markPivot.rotation.y = Math.sin(t * 0.33 + 1) * 0.08 + e * 0.18;
+    sweep.position.set(Math.cos(t * 0.45) * 6, 3 + Math.sin(t * 0.3) * 2, 4 + Math.sin(t * 0.45) * 3);
+    placeScreen('gl', sm.p, t, 0);
+    placeScreen('hb', sm.p, t, 1);
+    camera.position.x = damp(camera.position.x, sm.px * 0.3, 3, dt);
+    camera.position.y = damp(camera.position.y, -sm.py * 0.18, 3, dt);
+    camera.position.z = 14 - e * 1.2;
+    camera.lookAt(e * L.logo.x * 0.5, e * 0.25, 0);
+    renderer.render(scene, camera);
+  }
+  const loop = () => frame(Math.min(clock.getDelta(), 1 / 20));
+  const play = (v) => {
+    if (!v.src) { v.src = v.dataset.src; v.load(); }
+    const r = v.play(); if (r && r.catch) r.catch(() => {});
+  };
+  /* runs only while on screen, with the tab visible and Pause motion off */
+  function setRunning(want) {
+    const on = Boolean(want) && inView && !G.paused && !document.hidden && host.classList.contains('is-live');
+    if (on === running) return;
+    running = on;
+    if (on) { clock.getDelta(); renderer.setAnimationLoop(loop); videos.forEach(play); }
+    else { renderer.setAnimationLoop(null); videos.forEach((v) => v.pause()); }
+  }
+  new IntersectionObserver((es) => { inView = es[es.length - 1].isIntersecting; setRunning(true); }).observe(host);
+  document.addEventListener('visibilitychange', () => setRunning(true));
+  (G.pauseFns = G.pauseFns || []).push(() => setRunning(true));
+  if (!G.onPauseChange) G.onPauseChange = (p) => G.pauseFns.forEach((fn) => fn(p));
+
+  /* the canvas joins the page only once its first frame is drawn, fading in over the still */
+  const go = () => {
+    frame(0);
+    host.appendChild(canvas);
+    if (canvas.animate && !G.paused) canvas.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 700, easing: 'cubic-bezier(.2,.8,.2,1)' });
+    host.classList.add('is-live');
+    setRunning(true);
+  };
+  (renderer.compileAsync ? renderer.compileAsync(scene, camera) : Promise.resolve()).then(go, go);
+}
diff --git a/assets/glass.css b/assets/glass.css
new file mode 100644
index 0000000..964429a
--- /dev/null
+++ b/assets/glass.css
@@ -0,0 +1,65 @@
+/* Cendavo Liquid Glass shell (Task 37), on every page after site.css: the floating glass nav pill, the colour-field
+   atmosphere behind the page, glass panels (.lg, .lg-dark), glass buttons and the glass footer wordmark. Light only: white
+   frosted glass over soft daylight colour, ink text, no neon. Panels are plain blur everywhere; glass.js adds an edge
+   refraction filter in Chromium (html.lg-refract) and moves the pointer highlight (--mx/--my). Without backdrop-filter
+   support, or when the visitor asks for reduced transparency, every panel is opaque. Motion stays in the guarded block. */
+
+/* Atmosphere: four soft colour fields, fixed behind everything (aria-hidden in the markup). glass.js drifts them slowly
+   on the motion pages; otherwise they stay where they are. Radial gradients, not blur filters, so they cost nothing. */
+.atmos{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
+.atmos i{position:absolute;width:62vmax;height:62vmax;border-radius:50%;opacity:.55}
+.atmos i:nth-child(1){left:48%;top:-22vmax;background:radial-gradient(closest-side,#EDBF72,rgba(237,191,114,0))}
+.atmos i:nth-child(2){left:-24vmax;top:18%;background:radial-gradient(closest-side,#A3C4DE,rgba(163,196,222,0))}
+.atmos i:nth-child(3){left:62%;top:48%;background:radial-gradient(closest-side,#B2CB9C,rgba(178,203,156,0));opacity:.45}
+.atmos i:nth-child(4){left:14%;top:70%;background:radial-gradient(closest-side,#E9BB9E,rgba(233,187,158,0));opacity:.4}
+
+/* Glass panel. --lg-filter is set by glass.js (Chromium: blur + displacement map); the fallback is a plain blur. The
+   ::before layer is the specular highlight, centred on the pointer (or a virtual sun above the page). */
+.lg,.site-header .nav{position:relative;isolation:isolate;background:linear-gradient(135deg,rgba(255,255,255,.66),rgba(255,255,255,.38));-webkit-backdrop-filter:blur(18px) saturate(1.8);backdrop-filter:var(--lg-filter,blur(18px) saturate(1.8));border:1px solid rgba(255,255,255,.72);box-shadow:inset 0 1px 0 rgba(255,255,255,.95),inset 0 -1px 0 rgba(255,255,255,.3),0 1px 2px rgba(14,14,13,.06),0 18px 40px -20px rgba(58,40,12,.3)}
+.lg::before,.site-header .nav::before{content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit;background:radial-gradient(110% 90% at var(--mx,30%) var(--my,-20%),rgba(255,255,255,.8),rgba(255,255,255,0) 55%);pointer-events:none}
+.lg-dark{background:linear-gradient(135deg,rgba(26,25,23,.82),rgba(14,14,13,.7));border-color:rgba(255,255,255,.16);color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 24px 60px -24px rgba(14,14,13,.6)}
+.lg-dark::before{background:radial-gradient(110% 90% at var(--mx,30%) var(--my,-20%),rgba(255,255,255,.14),rgba(255,255,255,0) 55%)}
+.lg-dark :focus-visible{outline-color:#fff}
+.lg-defs{position:absolute;overflow:hidden}
+
+/* Header: a floating glass pill. It stays in the page flow (sticky), so it never covers content on load; site.js hides
+   it while scrolling down and brings it back on scrolling up or when anything in it takes focus. */
+.site-header{padding:12px var(--gut) 0;background:none;-webkit-backdrop-filter:none;backdrop-filter:none;border:0;pointer-events:none}
+.site-header .nav{max-width:calc(var(--max) - 2 * var(--gut));min-height:64px;padding-inline:22px 10px;border-radius:32px;pointer-events:auto}
+.site-header.is-hidden{transform:translateY(calc(-100% - 16px))}
+.site-header .button{box-shadow:inset 0 1px 0 rgba(255,255,255,.22)}
+.menu{background:rgba(255,255,255,.5);border-color:rgba(14,14,13,.12)}
+
+/* Buttons: the outline button becomes glass; the ink button gets a lit top edge. */
+.button.outline{background:rgba(255,255,255,.42);-webkit-backdrop-filter:blur(12px) saturate(1.6);backdrop-filter:blur(12px) saturate(1.6);border-color:rgba(255,255,255,.85);box-shadow:inset 0 1px 0 #fff,0 10px 24px -14px rgba(58,40,12,.35)}
+.button.outline:hover{background:rgba(255,255,255,.7);border-color:#fff}
+.button.dark{box-shadow:inset 0 1px 0 rgba(255,255,255,.22),0 12px 26px -12px rgba(14,14,13,.55)}
+
+/* Footer: glass over the atmosphere, and the large wordmark drawn as white glass (a lit gradient with a soft drop
+   shadow; decorative and aria-hidden in the markup). */
+.footer{border-top:0;background:linear-gradient(180deg,rgba(255,255,255,0),rgba(246,245,241,.7))}
+.footer-bottom{border-top-color:rgba(14,14,13,.1)}
+.footer-sign{height:.66em;padding-top:.04em;color:#F1EEE7}
+.footer-word{background:linear-gradient(176deg,#fff 18%,#E7E3DA 46%,#fff 52%,#DCD7CC 88%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.9);filter:drop-shadow(0 .04em .05em rgba(58,40,12,.14))}
+
+/* Lenis smooth scrolling (motion pages only): native smooth scrolling must not fight it while it animates. */
+.lenis.lenis-smooth{scroll-behavior:auto!important}
+
+/* Opaque fallbacks: no backdrop-filter, or the visitor asked for less transparency. */
+@supports not ((-webkit-backdrop-filter:blur(1px)) or (backdrop-filter:blur(1px))){
+.lg,.site-header .nav,.button.outline{background:#FBFAF7}
+.lg-dark{background:#1A1917}
+}
+@media(prefers-reduced-transparency:reduce){
+.lg,.site-header .nav,.button.outline{background:#FBFAF7;-webkit-backdrop-filter:none;backdrop-filter:none}
+.lg-dark{background:#1A1917}
+.atmos{display:none}
+}
+@media(max-width:1080px){
+.site-header .nav{padding-block:8px}
+.js .nav-links.open{max-height:calc(100svh - 160px);overflow-y:auto}
+}
+
+@media(prefers-reduced-motion:no-preference){
+.site-header{transition:transform var(--dur-1) var(--ease-io)}
+}
diff --git a/assets/glass.js b/assets/glass.js
new file mode 100644
index 0000000..888c754
--- /dev/null
+++ b/assets/glass.js
@@ -0,0 +1,137 @@
+// Liquid Glass shell for the motion pages (Task 37), after GSAP and Lenis: the pointer light on glass panels, the edge
+// refraction filter (Chromium only), Lenis smooth scrolling and the slow drift of the colour-field atmosphere. Nothing
+// here hides or moves content: without it every panel is plain frosted glass and scrolling is native. Under reduced
+// motion there is no Lenis, no drift and no moving light; under Save-Data no refraction maps are drawn.
+(() => {
+  const win = window, doc = document, root = doc.documentElement;
+  const motionOK = Boolean(win.matchMedia?.('(prefers-reduced-motion: no-preference)').matches);
+  const saveData = Boolean(win.navigator?.connection?.saveData);
+  // Shared with reel.js (Pause motion), home.js (hero scroll) and the WebGL hero (glass-scene.js).
+  const G = win.__glass = win.__glass || { paused: false, heroP: 0, pointer: { x: 0, y: 0 } };
+  G.pointer = G.pointer || { x: 0, y: 0 };
+  const pauseFns = G.pauseFns = G.pauseFns || [];
+  G.onPauseChange = paused => pauseFns.forEach(fn => fn(paused));
+  const $$ = selector => Array.from(doc.querySelectorAll(selector));
+  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
+  const GLASS = '.lg, .site-header .nav';
+
+  // Pointer light: each visible panel's highlight sits where the pointer is (a virtual sun above the page otherwise).
+  const visible = new Set();
+  let px = null, py = null, raf = 0;
+  const paint = () => {
+    raf = 0;
+    const lx = px === null ? win.innerWidth * 0.3 : px, ly = py === null ? -win.innerHeight * 0.2 : py;
+    visible.forEach(el => {
+      const r = el.getBoundingClientRect();
+      if (!r.width) return;
+      el.style.setProperty('--mx', clamp((lx - r.left) / r.width * 100, -30, 130).toFixed(1) + '%');
+      el.style.setProperty('--my', clamp((ly - r.top) / r.height * 100, -40, 140).toFixed(1) + '%');
+    });
+  };
+  const schedule = () => { if (!raf) raf = win.requestAnimationFrame(paint); };
+  if (motionOK && win.IntersectionObserver) {
+    const io = new win.IntersectionObserver(entries => {
+      entries.forEach(e => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
+      schedule();
+    }, { rootMargin: '80px' });
+    $$(GLASS).forEach(el => io.observe(el));
+    win.addEventListener('pointermove', e => {
+      if (e.pointerType === 'touch') return;
+      px = e.clientX; py = e.clientY;
+      G.pointer.x = e.clientX / win.innerWidth * 2 - 1;
+      G.pointer.y = e.clientY / win.innerHeight * 2 - 1;
+      schedule();
+    }, { passive: true });
+    win.addEventListener('scroll', schedule, { passive: true });
+  }
+
+  // Edge refraction (Chromium: backdrop-filter accepts an SVG filter). One displacement map per panel size: the backdrop
+  // bends inward along a band at the rounded edge, flat in the middle so text behind stays steady.
+  const brands = win.navigator?.userAgentData?.brands || [];
+  const defs = doc.querySelector('[data-lg-defs]');
+  if (defs && motionOK && !saveData && brands.some(b => /Chromium/.test(b.brand))) {
+    root.classList.add('lg-refract');
+    const NS = defs.namespaceURI, cache = {}; // the SVG namespace, read from the page's own <defs>
+    let n = 0;
+    const map = (w, h, r, band) => {
+      const cw = Math.max(2, Math.round(w / 2)), ch = Math.max(2, Math.round(h / 2));
+      const c = doc.createElement('canvas');
+      c.width = cw; c.height = ch;
+      const ctx = c.getContext('2d'), img = ctx.createImageData(cw, ch), d = img.data, hw = w / 2, hh = h / 2;
+      r = Math.min(r, hw, hh);
+      for (let j = 0; j < ch; j++) for (let i = 0; i < cw; i++) {
+        const x = i * 2 + 1 - hw, y = j * 2 + 1 - hh, qx = Math.abs(x) - (hw - r), qy = Math.abs(y) - (hh - r);
+        const depth = r - Math.hypot(Math.max(qx, 0), Math.max(qy, 0)) - Math.min(Math.max(qx, qy), 0);
+        let nx = 0, ny = 0, mag = 0;
+        if (depth > 0 && depth < band) {
+          if (qx > 0 && qy > 0) { const l = Math.hypot(qx, qy) || 1; nx = qx / l * Math.sign(x); ny = qy / l * Math.sign(y); }
+          else if (qx > qy) nx = Math.sign(x); else ny = Math.sign(y);
+          const t = 1 - depth / band; mag = t * t * (3 - 2 * t);
+        }
+        const k = (j * cw + i) * 4;
+        d[k] = 128 - nx * mag * 127; d[k + 1] = 128 - ny * mag * 127; d[k + 2] = 128; d[k + 3] = 255;
+      }
+      ctx.putImageData(img, 0, 0);
+      return c.toDataURL('image/png');
+    };
+    const make = (tag, attrs) => { const el = doc.createElementNS(NS, tag); Object.keys(attrs).forEach(k => el.setAttribute(k, attrs[k])); return el; };
+    const filterFor = (w, h, r) => {
+      const key = w + 'x' + h + 'r' + r;
+      if (cache[key]) return cache[key];
+      const band = Math.max(8, Math.min(30, Math.min(w, h) * 0.32)), id = 'lgf' + n++, box = { x: 0, y: 0, width: w, height: h };
+      const f = make('filter', { id, filterUnits: 'userSpaceOnUse', primitiveUnits: 'userSpaceOnUse', 'color-interpolation-filters': 'sRGB', ...box });
+      f.appendChild(make('feImage', { href: map(w, h, r, band), preserveAspectRatio: 'none', result: 'm', ...box }));
+      f.appendChild(make('feDisplacementMap', { in: 'SourceGraphic', in2: 'm', scale: Math.round(Math.min(band * 1.1, 34)), xChannelSelector: 'R', yChannelSelector: 'G' }));
+      defs.appendChild(f);
+      return (cache[key] = id);
+    };
+    const apply = () => $$(GLASS).forEach(el => {
+      const w = Math.round(el.offsetWidth), h = Math.round(el.offsetHeight);
+      if (!w || !h || w * h > 1400 * 900) return;
+      const radius = getComputedStyle(el).borderTopLeftRadius;
+      const r = /%/.test(radius) ? Math.min(w, h) / 2 : parseFloat(radius) || 0;
+      el.style.setProperty('--lg-filter', 'blur(10px) url(#' + filterFor(w, h, Math.round(r)) + ') saturate(1.8) brightness(1.05)');
+    });
+    let timer = 0;
+    win.addEventListener('resize', () => { win.clearTimeout(timer); timer = win.setTimeout(apply, 300); });
+    (doc.fonts?.ready || Promise.resolve()).then(apply);
+    G.reapplyRefraction = apply;
+  }
+  if (!motionOK) return;
+
+  // Lenis smooth scrolling, driven by GSAP's ticker so ScrollTrigger stays in step. Touch scrolling stays native.
+  const gsap = win.gsap, ScrollTrigger = win.ScrollTrigger;
+  if (win.Lenis) {
+    const lenis = G.lenis = new win.Lenis({ lerp: 0.1, smoothWheel: true });
+    if (gsap && ScrollTrigger) {
+      lenis.on('scroll', ScrollTrigger.update);
+      gsap.ticker.add(t => lenis.raf(t * 1000));
+    } else {
+      const tick = t => { lenis.raf(t); win.requestAnimationFrame(tick); };
+      win.requestAnimationFrame(tick);
+    }
+  }
+
+  // The atmosphere drifts on slow, separate sine paths (40 to 70 s), transform only; held by Pause motion and a hidden tab.
+  const fields = $$('.atmos i');
+  let drift = 0, t0 = 0;
+  const step = now => {
+    t0 = t0 || now;
+    const t = (now - t0) / 1000;
+    fields.forEach((el, i) => {
+      const s = 0.09 + i * 0.025;
+      el.style.transform = 'translate3d(' + (Math.sin(t * s + i * 1.7) * 5).toFixed(2) + 'vmax,' + (Math.cos(t * s * 0.8 + i) * 4).toFixed(2) + 'vmax,0)';
+    });
+    drift = win.requestAnimationFrame(step);
+  };
+  const run = () => {
+    const on = !G.paused && !doc.hidden;
+    if (on && !drift) drift = win.requestAnimationFrame(step);
+    else if (!on && drift) { win.cancelAnimationFrame(drift); drift = 0; }
+  };
+  if (fields.length) {
+    pauseFns.push(run);
+    doc.addEventListener('visibilitychange', run);
+    run();
+  }
+})();
